void setup()
{
  pinMode(13,OUTPUT);
  pinMode(12,OUTPUT);
  pinMode(11,OUTPUT);
}

void loop()
{
  
  tone(13,300);//saaaaaaaaaaaaaaaaa
  delay(500);

  tone(13,500); //reeeeeeeeeeeeeeeeeeeeeeeeeeee
  delay(500);

  tone(13,700);//gaaaaaaaaaaaaaaaaa
  delay(500);

  tone(13,900);//maaaaaaaaaaaaa
  delay(500);

  tone(13,1200);//paaaaaaaaaaaaaa
  delay(500);

  tone(13,1500);//dhaaaaaaaaaaa
  delay(500);

  tone(13,1800);//niiiiiiii
  delay(500);

  tone(13,1600);//saaaaaaaaaaaaaaaaaaaaaaa
  delay(500);
}
